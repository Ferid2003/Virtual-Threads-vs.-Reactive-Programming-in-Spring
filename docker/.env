# Defaults; override per command (e.g. APP_CPUS=1 JDK=25 docker compose up -d). load/run.sh sets
# JDK, APP_CPUS, RUN_DIR, HOST_UID and HOST_GID itself.
JDK=21
APP_CPUS=2
APP_MEM=1g
JVM_HEAP=512m
STUB_DELAY_MS=50
STUB_CPUS=2
DB_CPUS=4
DB_MEM=2g
# Optional CPU pinning (e.g. APP_CPUSET=0-3 DB_CPUSET=4-7 STUB_CPUSET=8-9); empty = no pinning.
APP_CPUSET=
DB_CPUSET=
STUB_CPUSET=
